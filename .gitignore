# The asset tree: 65,259 part files and 118 GiB. Never commit those. The
# _headers file is committed so the public directory always exists, because
# wrangler refuses to deploy when the assets directory is missing.
public/*
!public/_headers

# The minified snippet, written by the build.
dist/

# The archive and any local copy.
*.pmtiles
.cache/

node_modules/
.wrangler/
__pycache__/
*.pyc
.DS_Store

# Browser test artefacts from the MCP playwright server.
.playwright-mcp/

# A dev-only copy of the PMTiles ESM build, so tools/check-fields.mjs can import
# it. The published copy at /vendor is the UMD build, which does not import in
# Node. Same package, same version, and it is not served anywhere.
tools/.pmtiles-cdn.mjs
