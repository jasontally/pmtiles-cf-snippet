{
  "name": "pmtiles-cf-snippet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serve a 118 GiB PMTiles archive from Cloudflare Static Assets with a Snippet",
  "scripts": {
    "test": "python3 shard-pmtiles.py --selftest && node --test snippet-rules.test.mjs && node snippet-test.js && node minify-test.js && node deploy-test.js && node web/make-styles.test.mjs && node tools/sync-reader.test.mjs && node tools/fetch-assets.test.mjs && node shard-repo/refresh.test.mjs && node shard-repo/shard-build.test.mjs",
    "test:rules": "node --test snippet-rules.test.mjs",
    "test:split": "python3 shard-pmtiles.py --selftest",
    "test:snippet": "node snippet-test.js",
    "test:minify": "node minify-test.js",
    "test:deploy": "node deploy-test.js",
    "build": "node build.mjs prepare",
    "build:snippet": "node build.mjs snippet",
    "doctor": "node build.mjs doctor",
    "deploy": "node build.mjs deploy",
    "deploy:assets-only": "npx wrangler deploy",
    "deploy:all": "node build.mjs all",
    "split": "python3 shard-pmtiles.py",
    "verify": "python3 shard-pmtiles.py",
    "verify:live": "python3 verify-live.py",
    "test:styles": "node web/make-styles.test.mjs",
    "styles": "node web/make-styles.mjs",
    "test:sync": "node tools/sync-reader.test.mjs",
    "sync": "node tools/sync-reader.mjs",
    "sync:plan": "node tools/sync-reader.mjs --plan",
    "test:shard-refresh": "node shard-repo/refresh.test.mjs",
    "test:shard-build": "node shard-repo/shard-build.test.mjs",
    "assets": "node tools/fetch-assets.mjs",
    "assets:check": "node tools/fetch-assets.mjs --check",
    "bench:assets": "node tools/bench-assets.mjs",
    "check:fields": "node tools/check-fields.mjs",
    "check:style": "node tools/check-style.mjs",
    "coverage": "node tools/layer-coverage.mjs",
    "coverage:full": "node tools/layer-coverage.mjs --full"
  }
}
